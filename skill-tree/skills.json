  "power_origins": {
    "innate": {
      "name_zh": "天生",
      "name_en": "Innate",
      "abbr": "天",
      "color": "#ffd166",
      "innate": true,
      "desc": "生来就有，从记事起就会用，像呼吸一样自然。",
      "how": "出生即拥有，无法后天获得，也无法传给别人。",
      "drawback": "没有额外代价，但无法学习、转移或强化来源。",
      "icon": "images/svg/origin_innate.svg"
    },
    "mutant": {
      "name_zh": "基因变异",
      "name_en": "Mutant",
      "abbr": "变",
      "color": "#ff5fa2",
      "innate": true,
      "desc": "能力写在基因里，平时沉睡，在青春期或极端压力下突然觉醒。",
      "how": "先天潜伏，在一次「觉醒事件」（生死危机、强烈情绪）中显现；无法后天注入。",
      "drawback": "觉醒初期难以控制，常伴随外貌异变，容易被社会排斥。",
      "icon": "images/svg/origin_mutant.svg"
    },
    "alien": {
      "name_zh": "外星血统",
      "name_en": "Alien",
      "abbr": "星",
      "color": "#5fd3ff",
      "innate": true,
      "desc": "身体本就不是地球人，能力来自异星生理结构。",
      "how": "与生俱来；只有流着异星之血的人才拥有。",
      "drawback": "依赖特定环境（如恒星光照）充能，对故乡的某种矿石极度虚弱。",
      "icon": "images/svg/origin_alien.svg"
    },
    "radiation": {
      "name_zh": "辐射事故",
      "name_en": "Accident",
      "abbr": "辐",
      "color": "#9dff3a",
      "innate": false,
      "desc": "实验室爆炸、宇宙射线、被辐射生物咬伤——一场意外改写了身体。",
      "how": "一次性事故事件获得，过程几乎无法复制。",
      "drawback": "能力常与情绪绑定而失控，身体留下慢性后遗症。",
      "icon": "images/svg/origin_radiation.svg"
    },
    "augment": {
      "name_zh": "科学改造",
      "name_en": "Augmented",
      "abbr": "改",
      "color": "#c0c8d8",
      "innate": false,
      "desc": "超级士兵血清、手术植入、机械义体——由科学一步步造出来的超人。",
      "how": "通过注射血清、手术或植入装置获得；需要实验室和大量资源。",
      "drawback": "血清不稳定需定期补剂，义体需维护充电，害怕电磁脉冲。",
      "icon": "images/svg/origin_augment.svg"
    },
    "mystic": {
      "name_zh": "魔法仪式",
      "name_en": "Mystic",
      "abbr": "魔",
      "color": "#b388ff",
      "innate": false,
      "desc": "研读禁书、完成古老仪式，从异界借来力量。",
      "how": "通过学习咒语、完成仪式获得；需要导师或典籍。",
      "drawback": "施法需要咒语与手势，消耗精神；仪式往往要付出等价之物。",
      "icon": "images/svg/origin_mystic.svg"
    },
    "divine": {
      "name_zh": "神赐契约",
      "name_en": "Divine / Pact",
      "abbr": "神",
      "color": "#ffe45c",
      "innate": false,
      "desc": "被神灵选中，或与恶魔立下契约，力量由更高存在授予。",
      "how": "由神祇或契约对象授予；可能需要一句咒语或一件信物。",
      "drawback": "必须遵守誓约，一旦违背，力量会被收回，甚至招致惩罚。",
      "icon": "images/svg/origin_divine.svg"
    },
    "symbiote": {
      "name_zh": "共生体",
      "name_en": "Symbiote",
      "abbr": "生",
      "color": "#a3a3c2",
      "innate": false,
      "desc": "一种活着的外来生物与宿主结合，互相供养。",
      "how": "与共生体接触并被它接纳；共生体也可能离开、换宿主。",
      "drawback": "怕声波与高温，宿主会逐渐被它的饥饿和情绪侵蚀。",
      "icon": "images/svg/origin_symbiote.svg"
    },
    "cosmic": {
      "name_zh": "宇宙神器",
      "name_en": "Cosmic Artifact",
      "abbr": "器",
      "color": "#7cf5c8",
      "innate": false,
      "desc": "戒指、宝石、权杖——来自宇宙的神器选中了你。",
      "how": "被神器选中或夺得神器；力量随神器而来，也随神器而去。",
      "drawback": "神器有能量上限需要充能，意志不足会失效，还可能被夺走。",
      "icon": "images/svg/origin_cosmic.svg"
    }
  },
